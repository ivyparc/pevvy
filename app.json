{
  "expo": {
    "name": "PET", "slug": "pet", "version": "0.1.0", "scheme": "pet",
    "orientation": "default", "userInterfaceStyle": "automatic",
    "icon": "./assets/images/icon.png",
    "ios": { "supportsTablet": true, "bundleIdentifier": "com.ivyparc.pet" },
    "android": { "package": "com.ivyparc.pet", "predictiveBackGestureEnabled": true },
    "web": { "output": "static", "favicon": "./assets/images/favicon.png" },
    "plugins": ["expo-router", "expo-localization", ["expo-splash-screen", {
      "backgroundColor": "#F8F9FA", "dark": { "backgroundColor": "#111816" }
    }]],
    "experiments": { "typedRoutes": true }
  }
}
